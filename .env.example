ANVIL_RPC_URL=127.0.0.1:8545
SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=

# Minimum time between two payroll runs, in seconds.
# Keep this line commented out for the production default
# (30 days = 2592000). Uncomment it only for a demo deployment.
# Never leave it defined and empty: forge loads the .env file
# automatically and the uint256 conversion would fail.
# PAYROLL_INTERVAL_SECONDS=10

# CRE relay (make deploy-relay-sepolia).
# Payroll contract the relay triggers: the defense demo instance (120 s).
PAYROLL_ADDRESS=0x2AEc0c1942032ce70f390e729a01fE95310bf3B7
# Chainlink Forwarder allowed to call the relay, per the CRE forwarder directory:
# - MockKeystoneForwarder, for broadcast simulations (cre workflow simulate --broadcast):
FORWARDER_ADDRESS=0x15fC6ae953E024d975e77382eEeC56A9101f9F88
# - KeystoneForwarder, once the workflow is deployed. Switch with
#   setForwarderAddress() on the relay rather than redeploying:
# FORWARDER_ADDRESS=0xF8344CFd5c43616a4366C34E3EEE75af79a74482
