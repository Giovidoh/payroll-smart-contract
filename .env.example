# Intervalle minimal entre deux executions de la paie, en secondes.
# Laisser cette ligne commentee pour la valeur de production par defaut
# (30 jours = 2592000). La decommenter uniquement pour un deploiement
# de demonstration. Ne jamais la laisser definie et vide : forge charge
# automatiquement le fichier .env et la conversion en uint256 echouerait.
# PAYROLL_INTERVAL_SECONDS=10
